{
  "name": "surgejs-sdk",
  "version": "1.0.0",
  "description": "Typed TypeScript API client for Surge.sh public endpoints",
  "author": "Michael McShinsky",
  "license": "MIT",
  "repository": "https://github.com/michaelmcshinsky/surgejs-sdk",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "size": "size-limit",
    "analyze": "size-limit --why",
    "docs:build": "typedoc src/index.ts",
    "release": "changeset publish",
    "version": "changeset version"
  },
  "devDependencies": {
    "@size-limit/preset-small-lib": "^11.1.6",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "msw": "^2.7.0",
    "size-limit": "^11.1.6",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^5.0.5"
  },
  "size-limit": [
    {
      "path": "dist/index.js",
      "limit": "8 KB"
    }
  ],
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.27.7": true,
    "msw@2.15.0": true
  }
}
