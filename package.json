{
  "name": "surgejs-sdk",
  "version": "1.0.0",
  "description": "Modern TypeScript SDK for the Surge.sh static publishing platform — full API client with streaming publish, upload dedupe, and end-to-end types.",
  "license": "MIT",
  "author": "Michael McShinsky",
  "type": "module",
  "engines": {
    "node": ">=18.13"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./stream": {
      "import": {
        "types": "./dist/stream/index.d.ts",
        "default": "./dist/stream/index.js"
      },
      "require": {
        "types": "./dist/stream/index.d.cts",
        "default": "./dist/stream/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "logo.png"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "prepack": "pnpm build",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src test",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "publint": "publint",
    "attw": "attw --pack . --profile node16",
    "check": "pnpm typecheck && pnpm lint && pnpm test:coverage && pnpm build && pnpm publint && pnpm attw",
    "release": "changeset publish"
  },
  "dependencies": {
    "ignore": "^7.0.13"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/michaelmcshinsky/surgejs-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/michaelmcshinsky/surgejs-sdk/issues"
  },
  "homepage": "https://github.com/michaelmcshinsky/surgejs-sdk#readme",
  "keywords": [
    "surge",
    "surge.sh",
    "deploy",
    "static",
    "hosting",
    "cdn",
    "publish",
    "sdk"
  ],
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^3.0.3",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.0.5",
    "oxlint": "^1.89.0",
    "publint": "^0.3.25",
    "tsdown": "^0.23.1",
    "typescript": "^5.9.3",
    "unrun": "^0.3.1",
    "vitest": "^5.0.5"
  }
}
